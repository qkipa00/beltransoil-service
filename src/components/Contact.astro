---
import type { SiteContent } from "../data/content";

type Props = {
  content: SiteContent;
};

const props = Astro.props;
const mailtoHref = `mailto:${props.content.contacts.email}?subject=${encodeURIComponent(
  props.content.contacts.mailSubject,
)}`;
---

<section class="section" id="contacts">
  <div class="contact-grid">
    <div class="contact-heading">
      <p class="eyebrow eyebrow-underline">{props.content.contacts.eyebrow}</p>
      <h2>{props.content.contacts.title}</h2>
    </div>

    <div class="contact-details">
      <strong>{props.content.contacts.company}</strong>

      {props.content.contacts.details.map((row) => (
        <div class="row">
          <span class="row-label">{row.label}</span>
          {row.href ? <a href={row.href}>{row.value}</a> : <span>{row.value}</span>}
        </div>
      ))}
    </div>

    <div class="contact-cta">
      <span class="contact-cta-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4.5" width="20" height="15" rx="3" />
          <path d="M3 7l8.1 5.4a1.6 1.6 0 001.8 0L21 7" />
        </svg>
      </span>
      <h3>{props.content.contacts.ctaTitle}</h3>
      <p>{props.content.contacts.ctaDescription}</p>
      <a class="button button-primary" href={mailtoHref}>{props.content.contacts.ctaButton}</a>
      <p class="contact-cta-address">
        <a href={mailtoHref}>{props.content.contacts.email}</a>
      </p>
    </div>
  </div>
</section>
