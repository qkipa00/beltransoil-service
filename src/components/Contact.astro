---
import type { SiteContent } from "../data/content";

type Props = {
  content: SiteContent;
};

const props = Astro.props;
---

<section class="section" id="contacts">
  <div class="contact-grid">
    <div class="contact-copy">
      <p class="eyebrow eyebrow-underline">{props.content.contacts.eyebrow}</p>
      <h2>{props.content.contacts.title}</h2>
      <p>{props.content.contacts.description}</p>

      <div class="contact-details">
        <strong>{props.content.contacts.company}</strong>

        {props.content.contacts.details.map((row) => (
          <div class="row">
            <span class="row-label">{row.label}</span>
            {row.href ? <a href={row.href}>{row.value}</a> : <span>{row.value}</span>}
          </div>
        ))}
      </div>
    </div>

    <form class="contact-form" name={`contact-${props.content.language}`} method="post" novalidate data-form-ready="email-later">
      <div class="form-fields">
        <input type="hidden" name="language" value={props.content.language} />
        <input type="hidden" name="startedAt" value="" data-started-at />
        <label class="form-honeypot">
          <span>Website</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <h3>{props.content.contacts.formTitle}</h3>

        <label>
          <span>{props.content.contacts.namePlaceholder}</span>
          <input type="text" name="name" autocomplete="name" placeholder={props.content.contacts.namePlaceholder} minlength="2" maxlength="80" required />
        </label>

        <label>
          <span>{props.content.contacts.companyPlaceholder}</span>
          <input type="text" name="company" autocomplete="organization" placeholder={props.content.contacts.companyPlaceholder} maxlength="120" />
        </label>

        <label>
          <span>{props.content.contacts.emailPlaceholder}</span>
          <input type="text" name="contact" autocomplete="email tel" placeholder={props.content.contacts.emailPlaceholder} maxlength="120" required />
        </label>

        <label>
          <span>{props.content.contacts.messagePlaceholder}</span>
          <textarea name="message" rows="4" maxlength="1200" placeholder={props.content.contacts.messagePlaceholder} required></textarea>
        </label>

        <button class="button button-primary" type="submit">{props.content.contacts.submit}</button>
        <p class="form-note">{props.content.contacts.note}</p>
        <p class="form-error" aria-live="polite"></p>
      </div>

      <div class="form-success" aria-live="polite">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="24" cy="24" r="20" />
          <path d="M15 24l6 6 12-12" />
        </svg>
        <h3>{props.content.contacts.successTitle}</h3>
        <p>{props.content.contacts.successMessage}</p>
      </div>
    </form>
  </div>
</section>
