---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Issuer from "../components/Issuer.astro";
import Suppliers from "../components/Suppliers.astro";
import Legal from "../components/Legal.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { ruContent } from "../data/content";
---

<BaseLayout content={ruContent}>
  <Header content={ruContent} />
  <main>
    <Hero content={ruContent} />
    <Services content={ruContent} />
    <Issuer content={ruContent} />
    <Suppliers content={ruContent} />
    <Legal content={ruContent} />
    <Contact content={ruContent} />
  </main>
  <Footer content={ruContent} />
</BaseLayout>
