---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Suppliers from "../components/Suppliers.astro";
import Legal from "../components/Legal.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { enContent } from "../data/content";
---

<BaseLayout content={enContent}>
  <Header content={enContent} />
  <main>
    <Hero content={enContent} />
    <Services content={enContent} />
    <Process content={enContent} />
    <Suppliers content={enContent} />
    <Legal content={enContent} />
    <Contact content={enContent} />
  </main>
  <Footer content={enContent} />
</BaseLayout>
